---
import { themes } from '../data/themes';
import { url } from '../lib/url';

interface Props {
  current: number;
}

const { current } = Astro.props;
const theme = themes.find((t) => t.id === current)!;
---

<nav class="switcher" aria-label="Layout options">
  <span class="label">{theme.id}. {theme.name}</span>
  {
    themes.map((t) => (
      <a href={url(`/layouts/${t.id}`)} aria-current={t.id === current ? 'page' : undefined}>
        {t.id}
      </a>
    ))
  }
  <a href={url('/original')} class="orig">Original</a>
</nav>

<style>
  .switcher {
    position: fixed;
    right: 16px;
    bottom: 16px;
    z-index: 50;
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 6px 6px 6px 14px;
    border-radius: 999px;
    background: rgba(20, 20, 20, 0.85);
    backdrop-filter: blur(8px);
    color: #fff;
    font-size: 0.8125rem;
  }
  .label {
    margin-right: 6px;
  }
  a {
    display: grid;
    place-items: center;
    min-width: 30px;
    height: 30px;
    padding: 0 8px;
    border-radius: 999px;
    color: #fff;
    text-decoration: none;
  }
  a:hover {
    background: rgba(255, 255, 255, 0.15);
  }
  a[aria-current='page'] {
    background: #fff;
    color: #111;
  }
  .orig {
    opacity: 0.7;
  }
</style>
