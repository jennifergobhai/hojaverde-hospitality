---
import { Image } from 'astro:assets';
import photo from '../../assets/hero-pour.webp';
import logo from '../../assets/logo-white.png';
import { site } from '../../data/site';
import LogoType from './LogoType.astro';

interface Props {
  /** 'type' sets the wordmark in the headline serif; 'image' uses the original logo file. */
  logo?: 'image' | 'type';
}
const { logo: logoVariant = 'type' } = Astro.props;
---

<section class="hero">
  <Image
    src={photo}
    alt="Spirit poured from a bottle into a clay copita on a stone counter before a green tiled wall"
    class="photo"
    widths={[800, 1280, 2000]}
    sizes="100vw"
    loading="eager"
    fetchpriority="high"
  />
  <div class="shade" aria-hidden="true"></div>

  <div class="wrap copy">
    {
      logoVariant === 'type' ? (
        <div class="logo-type"><LogoType /></div>
      ) : (
        <Image src={logo} alt={site.name} class="logo" widths={[340, 680]} sizes="340px" loading="eager" />
      )
    }
    <h1>More than a tasting,<br />a deeper way to gather</h1>
    <ul class="pillars" aria-label="What we offer">
      <li>Mindful sipping</li>
      <li>Shared presence</li>
      <li>Cultural curiosity</li>
      <li>Meaningful connection</li>
    </ul>
  </div>
</section>

<style>
  .hero {
    position: relative;
    display: grid;
    align-items: center;
    min-height: min(calc(100svh - 80px), 900px);
    padding: clamp(72px, 10vw, 120px) 0;
    overflow: hidden;
    background: #1e1109;
    color: var(--cream);
  }
  .photo {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 42% 50%;
  }
  .shade {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(90deg, rgba(20, 14, 9, 0.85) 0%, rgba(20, 14, 9, 0.65) 32%, rgba(20, 14, 9, 0.1) 58%, rgba(20, 14, 9, 0) 72%),
      linear-gradient(0deg, rgba(26, 18, 12, 0.35), rgba(26, 18, 12, 0) 40%);
  }
  .copy {
    position: relative;
    padding-left: clamp(0px, 3vw, 48px);
    animation: rise 1.1s ease both 0.15s;
  }
  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(18px);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .copy {
      animation: none;
    }
  }
  .copy :global(.logo) {
    width: clamp(220px, 25vw, 340px);
    margin-bottom: clamp(28px, 4vw, 44px);
  }
  .logo-type {
    --logo-size: clamp(24.75px, 2.8125vw, 38.25px);
    margin-bottom: clamp(68px, 9.5vw, 132px);
  }
  h1 {
    /* Softened marigold: lighter and less saturated than the brand accent. */
    color: #e8c07e;
    font-size: clamp(1.53rem, 2.754vw, 2.6775rem);
    /* Lower optical size gives Bodoni's hairlines enough weight to read over the photo. */
    font-variation-settings: 'opsz' 12;
    /* The rule under the tagline runs exactly the width of its longest line. */
    width: fit-content;
    padding-bottom: 16px;
    border-bottom: 1px solid rgba(255, 245, 226, 0.35);
  }
  .pillars {
    display: flex;
    max-width: 620px;
    flex-wrap: wrap;
    gap: 10px 0;
    margin: 16px 0 0;
    padding: 0;
    list-style: none;
    color: var(--cream);
    font-size: 0.8125rem;
    font-weight: 400;
    letter-spacing: 0.24em;
    text-transform: uppercase;
  }
  .pillars li {
    display: inline-flex;
    align-items: center;
    white-space: nowrap;
  }
  .pillars li:not(:last-child)::after {
    content: '';
    width: 6px;
    height: 6px;
    margin: 0 18px;
    background: var(--marigold);
    transform: rotate(45deg);
  }

  @media (max-width: 760px) {
    .pillars {
      flex-direction: column;
    }
    .pillars li:not(:last-child)::after {
      display: none;
    }
    .hero {
      align-items: end;
      min-height: calc(100svh - 68px);
      padding-bottom: 56px;
    }
    .photo {
      object-position: 74% 50%;
    }
    .shade {
      background: linear-gradient(0deg, rgba(20, 14, 9, 0.95) 0%, rgba(20, 14, 9, 0.78) 45%, rgba(20, 14, 9, 0.1) 75%);
    }
  }
</style>
