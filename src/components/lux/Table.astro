---
import { stoneBg } from '../../lib/stone';

const stone = await stoneBg();

const spirits = ['Tequila', 'Mezcal', 'Bacanora', 'Raicilla', 'Sotol', 'Destilado de agave', 'Mexican rum', 'Whiskey', 'Gin', 'Amaros'];
---

<section id="table" class="table" aria-label="The spirits" style={`--stone: ${stone};`}>
  <div class="wrap inner">
    <ul class="spirits" aria-label="Spirits we pour" data-reveal>
      {spirits.map((s) => <li>{s}</li>)}
    </ul>
    <span class="rule" aria-hidden="true"></span>
    <p class="body" data-reveal>
      Journey through Mexico’s rich and dynamic world of spirits — tequila, mezcal, bacanora, raicilla, sotol, destilado
      de agave, along with Mexican rum, whiskey, gin, and amaros. Each bottle tells a story of craft, culture, and terroir
      — a reflection of the land and the hands that shape it.
    </p>
  </div>
</section>

<script>
  // Hide the diamond after any name that ends a wrapped line.
  const list = document.querySelector<HTMLElement>('#table .spirits');
  if (list) {
    const mark = () => {
      const items = [...list.children] as HTMLElement[];
      items.forEach((li, i) => {
        const next = items[i + 1];
        li.classList.toggle('eol', !!next && next.offsetTop > li.offsetTop);
      });
    };
    new ResizeObserver(mark).observe(list);
    document.fonts?.ready.then(mark);
  }
</script>

<style>
  .table {
    position: relative;
    padding: clamp(72px, 10vw, 130px) 0;
    color: var(--cream);
    background: linear-gradient(180deg, rgba(20, 10, 5, 0.2), rgba(20, 10, 5, 0.35)), var(--stone) center / cover, #2a1810;
  }
  .inner {
    display: grid;
    justify-items: center;
    text-align: center;
  }
  .spirits {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 8px 0;
    max-width: 1000px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .spirits li {
    font-family: var(--display);
    font-size: clamp(1.1rem, 1.92vw, 1.6rem);
    font-variation-settings: 'opsz' 12;
    white-space: nowrap;
  }
  .spirits li:not(:last-child)::after {
    content: '';
    display: inline-block;
    width: 6px;
    height: 6px;
    margin: 0 16px;
    vertical-align: middle;
    background: var(--clay);
    transform: rotate(45deg) translateY(-2px);
  }
  .spirits li.eol::after {
    display: none;
  }
  .rule {
    width: 64px;
    height: 1px;
    margin: clamp(32px, 4vw, 44px) 0;
    background: rgba(255, 245, 226, 0.35);
  }
  .body {
    max-width: 40em;
    margin: 0;
    color: rgba(255, 245, 226, 0.88);
    font-size: 1.125rem;
    line-height: 1.8;
  }
  @media (max-width: 800px) {
    .spirits li:not(:last-child)::after {
      margin: 0 12px;
    }
  }
</style>
