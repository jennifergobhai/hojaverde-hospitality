---
import { Image } from 'astro:assets';
import logo from '../../assets/logo-white.png';
import { site } from '../../data/site';
import { plaster } from '../../lib/textures';
import { woodBg } from '../../lib/wood';

const wood = await woodBg();
const year = new Date().getFullYear();
---

<footer id="inquire" class="inquire" style={`--wood: ${wood}; --plaster-tex: ${plaster};`}>
  <div class="wrap cta" data-reveal>
    <p class="eyebrow">Inquire</p>
    <h2>Gather around<br />the table</h2>
    <p class="body">Private dinners, corporate gatherings, and celebrations of every size. Tell us about yours.</p>
  </div>

  <form class="form wrap" id="inquiry-form" data-email={site.email} data-reveal>
    <div class="row">
      <label>Full name<input name="name" autocomplete="name" required /></label>
      <label>Email<input name="email" type="email" autocomplete="email" required /></label>
    </div>
    <div class="row">
      <label>Occasion
        <select name="occasion">
          <option value="">Select…</option>
          <option>Private dinner</option>
          <option>Corporate gathering</option>
          <option>Intimate celebration</option>
          <option>Reception or larger event</option>
          <option>Something else</option>
        </select>
      </label>
      <label>Preferred date<input name="date" type="date" /></label>
      <label>Guests<input name="guests" type="number" min="1" inputmode="numeric" /></label>
    </div>
    <fieldset>
      <legend>Format</legend>
      <label class="choice"><input type="radio" name="format" value="Seated tasting" /> Seated</label>
      <label class="choice"><input type="radio" name="format" value="Reception-style tasting" /> Reception-style</label>
      <label class="choice"><input type="radio" name="format" value="Not sure yet" /> Not sure yet</label>
      <label class="choice"><input type="checkbox" name="pairings" value="Yes" /> Interested in pairings</label>
    </fieldset>
    <label>Your vision<textarea name="message" rows="4"></textarea></label>
    <div class="submit">
      <button class="btn btn-solid" type="submit">Begin your inquiry</button>
      <p class="note">Opens your email app with the details filled in. Or write to <a href={`mailto:${site.email}`}>{site.email}</a>.</p>
    </div>
  </form>

  <script>
    const form = document.getElementById('inquiry-form') as HTMLFormElement;
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const d = new FormData(form);
      const get = (k: string) => String(d.get(k) ?? '').trim();
      const lines = [
        `Name: ${get('name')}`,
        `Email: ${get('email')}`,
        `Occasion: ${get('occasion') || '—'}`,
        `Preferred date: ${get('date') || '—'}`,
        `Guests: ${get('guests') || '—'}`,
        `Format: ${get('format') || '—'}`,
        `Pairings: ${get('pairings') ? 'Yes' : 'No'}`,
        '',
        get('message'),
      ];
      const subject = `Tasting inquiry${get('occasion') ? ` — ${get('occasion')}` : ''}`;
      window.location.href = `mailto:${form.dataset.email}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(lines.join('\n'))}`;
    });
  </script>

  <div class="wrap base">
    <Image src={logo} alt={site.name} width={260} widths={[160, 320]} sizes="160px" class="logo" />
    <p class="host">{site.host}</p>
    <p class="legal">© {year} {site.name}</p>
  </div>
</footer>

<style>
  .inquire {
    padding: clamp(72px, 10vw, 130px) 0 40px;
    color: var(--cream);
    background: linear-gradient(180deg, rgba(52, 26, 12, 0.82), rgba(30, 14, 6, 0.92)), var(--wood) center / cover, #2b1b11;
  }
  .cta {
    display: grid;
    justify-items: center;
    text-align: center;
  }
  .eyebrow {
    color: var(--marigold);
  }
  .eyebrow::before {
    display: none;
  }
  h2 {
    margin-top: 20px;
    font-size: clamp(2.75rem, 6vw, 4.75rem);
  }
  .body {
    max-width: 30em;
    margin: 24px 0 48px;
    color: rgba(251, 244, 228, 0.8);
  }
  .form {
    display: grid;
    gap: 22px;
    max-width: 820px;
    margin-top: 8px;
    padding: clamp(28px, 5vw, 56px);
    border-radius: 4px;
    background: var(--plaster-tex), var(--plaster);
    background-size: 600px 600px, auto;
    color: var(--ink);
    box-shadow: 0 40px 70px -30px rgba(0, 0, 0, 0.7);
  }
  .row {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 22px;
  }
  label,
  legend {
    display: grid;
    gap: 8px;
    font-size: 0.6875rem;
    font-weight: 400;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--ink-soft);
  }
  input:not([type='radio'], [type='checkbox']),
  select,
  textarea {
    width: 100%;
    min-height: 46px;
    padding: 10px 2px;
    border: 0;
    border-bottom: 1px solid rgba(42, 29, 21, 0.35);
    border-radius: 0;
    background: transparent;
    color: var(--ink);
    font: 300 1.0625rem/1.4 var(--sans);
    letter-spacing: 0;
    text-transform: none;
  }
  textarea {
    resize: vertical;
  }
  input:focus,
  select:focus,
  textarea:focus {
    outline: none;
    border-bottom-color: var(--terracotta);
  }
  fieldset {
    display: flex;
    flex-wrap: wrap;
    gap: 12px 28px;
    margin: 0;
    padding: 0;
    border: 0;
  }
  legend {
    width: 100%;
    margin-bottom: 12px;
  }
  .choice {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-size: 1rem;
    font-weight: 300;
    letter-spacing: 0;
    text-transform: none;
    color: var(--ink);
    cursor: pointer;
  }
  .choice input {
    width: 18px;
    height: 18px;
    accent-color: var(--terracotta);
  }
  .submit {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 16px 24px;
    margin-top: 8px;
  }
  .note {
    flex: 1 1 240px;
    margin: 0;
    color: var(--ink-soft);
    font-size: 0.875rem;
    overflow-wrap: anywhere;
  }
  .base {
    display: grid;
    justify-items: center;
    gap: 6px;
    margin-top: clamp(80px, 10vw, 130px);
    padding-top: 48px;
    border-top: 1px solid rgba(251, 244, 228, 0.16);
    text-align: center;
  }
  .logo {
    width: 150px;
    margin-bottom: 18px;
  }
  .host {
    margin: 0;
    font-size: 0.8125rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
  }
  .legal {
    margin: 0;
    color: rgba(251, 244, 228, 0.55);
    font-size: 0.75rem;
    letter-spacing: 0.12em;
  }
</style>
