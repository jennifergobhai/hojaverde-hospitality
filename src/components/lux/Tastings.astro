---
import { offerings } from '../../data/site';
import { plaster, talavera } from '../../lib/textures';

const numerals = ['I', 'II', 'III'];
---

<section id="tastings" class="tastings" style={`--plaster-tex: ${plaster}; --talavera: ${talavera()};`}>
  <div class="wrap">
    <header class="head" data-reveal>
      <p class="eyebrow">Chapter three · The tastings</p>
      <h2>Ways to gather</h2>
    </header>

    <ul class="cards">
      {
        offerings.map((o, i) => (
          <li class="card" data-reveal style={`transition-delay: ${i * 120}ms`}>
            <span class="tile" aria-hidden="true" />
            <span class="num italic" aria-hidden="true">{numerals[i]}</span>
            <h3>{o.title}</h3>
            <p>{o.body}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .tastings {
    padding: clamp(88px, 11vw, 150px) 0;
    background: var(--plaster-tex), var(--plaster-deep);
    background-size: 600px 600px, auto;
  }
  .head {
    display: grid;
    justify-items: center;
    text-align: center;
  }
  .eyebrow {
    color: var(--terracotta);
  }
  h2 {
    margin-top: 20px;
    font-size: clamp(2.75rem, 6vw, 4.75rem);
  }
  .cards {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(20px, 3vw, 36px);
    margin: clamp(56px, 7vw, 88px) 0 0;
    padding: 0;
    list-style: none;
  }
  .card {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 76px clamp(24px, 3vw, 40px) 48px;
    border-radius: 999px 999px 4px 4px;
    background: var(--cream);
    box-shadow: 0 1px 0 rgba(42, 29, 21, 0.08), 0 30px 50px -30px rgba(42, 29, 21, 0.35);
    text-align: center;
  }
  .card::before {
    content: '';
    position: absolute;
    inset: 10px;
    border: 1px solid rgba(201, 73, 31, 0.35);
    border-radius: inherit;
    pointer-events: none;
  }
  .tile {
    width: 64px;
    height: 64px;
    background: var(--talavera) center / 64px 64px;
    box-shadow: 0 6px 12px -6px rgba(42, 29, 21, 0.5);
    transform: rotate(45deg);
  }
  .num {
    margin-top: 34px;
    color: var(--terracotta);
    font-size: 1.5rem;
  }
  h3 {
    margin-top: 10px;
    font-size: clamp(1.75rem, 2.6vw, 2.25rem);
    line-height: 1.1;
  }
  .card p {
    margin: 18px 0 0;
    color: var(--ink-soft);
  }
  @media (max-width: 900px) {
    .cards {
      grid-template-columns: 1fr;
      max-width: 460px;
      margin-inline: auto;
    }
  }
</style>
