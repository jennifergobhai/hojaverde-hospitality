---
import { Image } from 'astro:assets';
import photo from '../../assets/ritual-table.webp';
---

<section id="ritual" class="ritual">
  <Image
    src={photo}
    alt="A tasting table from above: glasses of spirits, a board of orange, lime and salt, dried fruit, cheese and a candle"
    class="photo"
    widths={[800, 1400, 2000]}
    sizes="100vw"
  />
  <div class="shade" aria-hidden="true"></div>
  <div class="wrap inner">
    <div class="copy" data-reveal>
      <h2>Kiss the spirit</h2>
      <p class="body">
        A mindful approach to tasting that awakens the senses and reveals the layers of aroma, texture, and complexity
        within every sip.
      </p>
    </div>
  </div>
</section>

<style>
  .ritual {
    position: relative;
    display: grid;
    align-items: center;
    min-height: clamp(460px, 46vw, 760px);
    padding: clamp(64px, 8vw, 110px) 0;
    overflow: hidden;
    background: #1a0e07;
    color: var(--cream);
  }
  .ritual :global(.photo) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 40% 50%;
  }
  /* Deepen the photo's dark right side so the cream text reads cleanly. */
  .shade {
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, rgba(20, 10, 5, 0) 45%, rgba(20, 10, 5, 0.45) 68%, rgba(20, 10, 5, 0.6) 100%);
  }
  .inner {
    position: relative;
    display: flex;
    justify-content: flex-end;
  }
  .copy {
    width: min(100%, 440px);
    margin-right: clamp(0px, 4vw, 80px);
  }
  h2 {
    /* Same softened gold as the hero tagline. */
    color: #e8c07e;
    font-size: clamp(2.125rem, 4.25vw, 3.625rem);
    font-variation-settings: 'opsz' 12;
  }
  .body {
    margin: 22px 0 0;
    color: rgba(255, 245, 226, 0.88);
    font-size: 1.125rem;
    line-height: 1.75;
  }

  @media (max-width: 760px) {
    .ritual {
      align-items: end;
      min-height: 560px;
    }
    .ritual :global(.photo) {
      object-position: 30% 50%;
    }
    .shade {
      background: linear-gradient(0deg, rgba(20, 10, 5, 0.9) 0%, rgba(20, 10, 5, 0.65) 45%, rgba(20, 10, 5, 0.1) 80%);
    }
    .inner {
      justify-content: flex-start;
    }
    .copy {
      margin-right: 0;
    }
  }
</style>
