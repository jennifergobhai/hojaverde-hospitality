---
import { stone } from '../../lib/textures';

const links = [
  { href: '#table', label: 'The Table' },
  { href: '#ritual', label: 'The Ritual' },
  { href: '#tastings', label: 'Tastings' },
  { href: '#evening', label: 'The Evening' },
];
---

<header class="header" style={`--stone: ${stone};`}>
  <div class="inner">
    <nav aria-label="Main">
      <ul>
        {links.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
      </ul>
    </nav>
    <a href="#inquire" class="btn btn-ghost inquire">Inquire</a>
  </div>
</header>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 20;
    /* Warm red-brown from the bottle in the hero photo, with a faint stone texture. */
    --bar: #34130a;
    background: var(--stone) 0 0 / 480px 480px, var(--bar);
    color: var(--cream);
    border-bottom: 1px solid rgba(255, 245, 226, 0.1);
  }
  .inner {
    position: relative;
    display: flex;
    align-items: center;
    gap: 32px;
    width: min(100% - 2 * var(--gutter), var(--max));
    min-height: 80px;
    margin-inline: auto;
  }
  nav {
    margin-inline: auto;
  }
  ul {
    display: flex;
    gap: 34px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  nav a {
    position: relative;
    font-size: 0.75rem;
    font-weight: 400;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    text-decoration: none;
  }
  nav a::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: -6px;
    height: 1px;
    background: var(--terracotta);
    transform: scaleX(0);
    transition: transform 0.3s;
  }
  nav a:hover::after {
    transform: scaleX(1);
  }
  .inquire:hover {
    background: var(--cream);
    border-color: var(--cream);
    color: var(--bar);
  }
  .inquire {
    position: absolute;
    right: var(--gutter);
    min-height: 40px;
    padding: 0 20px;
    font-size: 0.6875rem;
  }
  @media (max-width: 900px) {
    nav {
      display: none;
    }
    .inquire {
      position: static;
      margin-left: auto;
    }
    .inner {
      min-height: 68px;
    }
  }
</style>
