---
// A wooden shelf of Oaxacan pottery, drawn as flat shapes with soft shading.
import { woodBg } from '../../lib/wood';

const wood = await woodBg(1200);
---

<div class="shelf" style={`--wood: ${wood};`} aria-hidden="true">
  <svg class="pots" viewBox="0 0 1200 220" preserveAspectRatio="xMidYMax meet">
    <defs>
      <radialGradient id="clay" cx="35%" cy="35%" r="75%"><stop offset="0" stop-color="#ea9560" /><stop offset="1" stop-color="#9c3311" /></radialGradient>
      <radialGradient id="barro" cx="35%" cy="30%" r="80%"><stop offset="0" stop-color="#5a4a42" /><stop offset="1" stop-color="#17110e" /></radialGradient>
      <radialGradient id="glaze" cx="35%" cy="30%" r="80%"><stop offset="0" stop-color="#62b04f" /><stop offset="1" stop-color="#1c5a22" /></radialGradient>
      <linearGradient id="gourd" x1="0" x2="1"><stop offset="0" stop-color="#f7c75a" /><stop offset=".6" stop-color="#f0a41c" /><stop offset="1" stop-color="#b8740e" /></linearGradient>
      <linearGradient id="wax" x1="0" x2="1"><stop offset="0" stop-color="#fffaf0" /><stop offset="1" stop-color="#e3d6bd" /></linearGradient>
    </defs>

    <!-- dried grasses in a clay vase -->
    <g transform="translate(90 0)" stroke="#c9a15a" stroke-width="1.6" fill="none" stroke-linecap="round">
      {Array.from({ length: 15 }, (_, i) => {
        const a = ((i - 7) / 7) * 0.8;
        return <path d={`M40 130 Q${40 + Math.sin(a) * 50} ${80} ${(40 + Math.sin(a) * 110).toFixed(1)} ${(130 - Math.cos(a) * 120).toFixed(1)}`} />;
      })}
    </g>
    <path d="M110 220 C96 196 100 158 118 136 H142 C160 158 164 196 150 220 Z" fill="url(#clay)" />

    <!-- tall candles -->
    <rect x="232" y="96" width="12" height="124" rx="2" fill="url(#wax)" />
    <rect x="252" y="120" width="12" height="100" rx="2" fill="url(#wax)" />
    <path d="M238 96 q-4-10 0-16 q4 6 0 16z M258 120 q-4-10 0-16 q4 6 0 16z" fill="#f0a41c" />

    <!-- copitas -->
    {[330, 380, 430].map((x) => (
      <g>
        <ellipse cx={x} cy="198" rx="22" ry="5" fill="#6b3522" />
        <path d={`M${x - 22} 198 C${x - 20} 218 ${x + 20} 218 ${x + 22} 198 Z`} fill="url(#clay)" />
      </g>
    ))}

    <!-- black clay (barro negro) jug -->
    <path d="M540 220 C488 212 486 140 530 122 C528 104 524 96 520 88 H572 C568 96 564 104 562 122 C606 140 604 212 552 220 Z" fill="url(#barro)" />
    <path d="M573 128 C606 118 612 160 588 170" fill="none" stroke="#2a1f1a" stroke-width="7" stroke-linecap="round" />

    <!-- gourd -->
    <path d="M690 220 C640 216 640 150 672 140 C662 110 668 72 690 56 C712 72 718 110 708 140 C740 150 740 216 690 220 Z" fill="url(#gourd)" />
    <path d="M690 56 v-12" stroke="#6b4428" stroke-width="4" stroke-linecap="round" />

    <!-- green glazed jarrito -->
    <path d="M820 220 C770 214 772 150 806 138 C800 124 800 114 804 106 H836 C840 114 840 124 834 138 C868 150 870 214 820 220 Z" fill="url(#glaze)" />
    <path d="M838 142 C866 132 870 170 850 178" fill="none" stroke="#1c5a22" stroke-width="6" stroke-linecap="round" />

    <!-- clay olla -->
    <path d="M960 220 C890 216 880 132 940 120 H980 C1040 132 1030 216 960 220 Z" fill="url(#clay)" />
    <ellipse cx="960" cy="120" rx="26" ry="6" fill="#6b3522" />

    <!-- agave sprig -->
    <g transform="translate(1060 60)" stroke="#3f8a3a" stroke-width="2" fill="none" stroke-linecap="round">
      <path d="M40 160 C30 110 16 60 0 20" /><path d="M42 160 C50 100 64 50 84 10" /><path d="M40 160 C24 130 8 118 -14 112" /><path d="M44 160 C60 128 80 116 100 112" />
    </g>
    <path d="M1080 220 C1072 200 1076 182 1086 176 H1118 C1128 182 1132 200 1124 220 Z" fill="url(#clay)" />
  </svg>
  <div class="plank"></div>
</div>

<style>
  .shelf {
    position: relative;
    width: min(100%, 1200px);
    margin-inline: auto;
  }
  .pots {
    display: block;
    width: 100%;
    height: auto;
    filter: drop-shadow(0 10px 8px rgba(0, 0, 0, 0.35));
  }
  .plank {
    height: 22px;
    border-radius: 2px;
    background: linear-gradient(180deg, rgba(255, 220, 170, 0.18), rgba(0, 0, 0, 0.25)), var(--wood) center / 1200px auto, #9c8468;
    box-shadow: 0 18px 22px -10px rgba(0, 0, 0, 0.55);
  }
</style>
