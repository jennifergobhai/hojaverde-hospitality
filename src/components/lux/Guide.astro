---
import Botanicals from './Botanicals.astro';
import { plaster } from '../../lib/textures';
import { site } from '../../data/site';
---

<section id="guide" class="guide" style={`--plaster-tex: ${plaster};`}>
  <Botanicals kind="sprig" class="sprig left" />
  <Botanicals kind="sprig" class="sprig right" />
  <figure class="wrap" data-reveal>
    <p class="eyebrow">Curated tastings · The spirit of Mexico</p>
    <blockquote>
      <p>Each spirit tells a story — of sun and soil, of hands and heart.</p>
    </blockquote>
    <figcaption>
      Guided by {site.host}, this is a journey of connection — between land, maker, and moment.
    </figcaption>
    <div class="ctas">
      <a class="btn btn-solid" href="#tastings">Explore the tastings</a>
      <a class="btn btn-ghost" href="#inquire">Inquire</a>
    </div>
  </figure>
</section>

<style>
  .guide {
    position: relative;
    overflow: hidden;
    padding: clamp(96px, 12vw, 170px) 0;
    background: radial-gradient(ellipse at 50% 40%, rgba(63, 138, 58, 0.55), transparent 65%), var(--plaster-tex), var(--agave-deep);
    background-size: auto, 600px 600px, auto;
    background-blend-mode: normal, soft-light, normal;
    color: var(--cream);
    text-align: center;
  }
  figure {
    position: relative;
    margin: 0 auto;
    max-width: 900px;
  }
  .eyebrow {
    color: var(--marigold);
  }
  .eyebrow::before {
    display: none;
  }
  blockquote {
    margin: 30px 0 0;
  }
  blockquote p {
    margin: 0;
    font-family: var(--display);
    font-size: clamp(2.125rem, 4.8vw, 4rem);
    font-variation-settings: 'opsz' 96;
    line-height: 1.12;
  }
  figcaption {
    max-width: 32em;
    margin: 36px auto 0;
    color: rgba(255, 245, 226, 0.88);
    font-size: 1.125rem;
  }
  .ctas {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 14px;
    margin-top: 44px;
  }
  .ctas .btn-ghost:hover {
    background: var(--cream);
    border-color: var(--cream);
    color: var(--ink);
  }
  .guide :global(.sprig) {
    position: absolute;
    top: 50%;
    width: clamp(90px, 12vw, 170px);
    color: rgba(240, 164, 28, 0.5);
    translate: 0 -50%;
  }
  .guide :global(.sprig.left) {
    left: clamp(-40px, 2vw, 40px);
    rotate: -8deg;
  }
  .guide :global(.sprig.right) {
    right: clamp(-40px, 2vw, 40px);
    rotate: 8deg;
    scale: -1 1;
  }
  @media (max-width: 700px) {
    .guide :global(.sprig) {
      opacity: 0.5;
    }
  }
</style>
