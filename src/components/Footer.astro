---
import { site } from '../data/site';
const year = new Date().getFullYear();
---

<footer class="footer">
  <p class="name">{site.host}</p>
  <a class="email" href={`mailto:${site.email}`}>{site.email}</a>
  <p class="copy">©{year} {site.name}</p>
</footer>

<style>
  .footer {
    display: grid;
    justify-items: center;
    gap: 2px;
    padding: 32px 16px 48px;
    background: var(--ink);
    text-align: center;
  }
  .name {
    margin: 0;
    color: var(--cream);
    font-size: 1.125rem;
    font-weight: 600;
    letter-spacing: 0.05em;
  }
  .email {
    color: var(--cream);
    font-size: 1rem;
    letter-spacing: 0.05em;
    text-underline-offset: 3px;
    overflow-wrap: anywhere;
  }
  .email:hover {
    color: var(--gold);
  }
  .copy {
    margin: 22px 0 0;
    color: var(--sand);
    font-size: 0.75rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }
</style>
